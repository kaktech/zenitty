# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL. Local: `docker compose up -d` (matches the URL below), or use a free Neon database.
# On Vercel/Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct (unpooled) one.
DATABASE_URL="postgresql://zenitty:zenitty@localhost:5432/zenitty"
DIRECT_URL="postgresql://zenitty:zenitty@localhost:5432/zenitty"

# Client (exposed to the browser)
VITE_USER_NAME=Abidemi
VITE_API_URL=/api
